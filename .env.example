APP_NAME=Deployment Manager
APP_ENV=development
APP_DEBUG=true
DOCKER_HOST=
DATABASE_URL=postgresql+psycopg://deployment_manager:deployment_manager@localhost:5432/deployment_manager
POSTGRES_DB=deployment_manager
POSTGRES_USER=deployment_manager
POSTGRES_PASSWORD=deployment_manager
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Bootstrap Admin
TRAEFIK_PUBLIC_NETWORK=dmgr-public
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_WEB_ENTRYPOINT=web
TRAEFIK_WEBSECURE_ENTRYPOINT=websecure
TRAEFIK_ACME_EMAIL=admin@example.com
